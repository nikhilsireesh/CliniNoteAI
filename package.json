{
  "name": "ai-clinical-note-structural-hackathon-1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"vite\" \"npm:server\"",
    "server": "tsx watch server/index.ts",
    "db:reset": "rm -f server/app.db && echo 'Database deleted — it will be recreated and reseeded next time the server starts.'",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
