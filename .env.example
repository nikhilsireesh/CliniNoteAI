# CliniNote AI — environment variables
#
# The app runs in full Demo Mode with no configuration at all: recording,
# transcription, AI structuring, and export all work against local mock data.
#
# To wire up real services later, set these on your SERVER (never expose
# provider API keys in frontend code). See src/services/aiService.ts and
# src/services/speechService.ts for the seams where a real backend call
# would replace the local mock implementation — e.g. a POST /api/structure-note
# route that forwards the transcript to an LLM and returns validated JSON
# matching the ClinicalNote schema in src/types/clinical.ts.

# LLM used for clinical note structuring (server-side only)
OPENAI_API_KEY=

# Optional: server-side speech-to-text (e.g. Whisper) if not using the
# browser's built-in Web Speech API
WHISPER_API_KEY=

# Database (server/db.ts). Leave both unset for local dev — it falls back to a plain
# SQLite file at server/app.db, no setup needed. In production (e.g. on Vercel), set
# both to a real hosted Turso database, since serverless functions can't persist a
# local file across invocations:
#   turso db create clininote
#   turso db show clininote --url          -> TURSO_DATABASE_URL
#   turso db tokens create clininote       -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
